<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.greennote.system.catalog.mapper.DepartmentMapper">

    <select id="listAll" resultType="com.greennote.system.catalog.controller.vo.DepartmentRow">
        SELECT id, name, parent_id, sort_no, status
        FROM gn_dept
        ORDER BY sort_no, id
    </select>

</mapper>
